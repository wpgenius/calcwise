{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "CalcWise demo",
		"description": "Installs the latest release and opens the CalcWise settings. The calculator demo page comes with v1.1.0 (#21).",
		"author": "wpgenius"
	},
	"landingPage": "/wp-admin/options-general.php?page=calcwise_settings",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/wpgenius/calcwise/releases/latest/download/calcwise.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "CalcWise demo",
				"permalink_structure": "/%postname%/"
			}
		}
	]
}
